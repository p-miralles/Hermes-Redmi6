# Active provider: groq or mistral
LLM_PROVIDER=groq

# Groq (active)
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Mistral (deactivated for now — kept for quick switch-back)
MISTRAL_API_KEY=your_key_here
MISTRAL_MODEL=mistral-small-latest

# WhatsApp daemon
SYSTEM_PROMPT=You are Hermes, a helpful personal assistant reachable over WhatsApp. Keep replies concise.
MEMORY_MAX_MESSAGES=40
